# Fairsquare environment. Copy to .env.local for local development.
# Every variable is optional locally; defaults are shown. Never commit real secrets.

# --- Database ---
# Unset -> PGlite in-process at PGLITE_DATA_DIR (local dev). Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# Production refuses to boot without DATABASE_URL unless this is true (Railway's disk is ephemeral).
ALLOW_PGLITE_IN_PRODUCTION=false

# --- Claude (screenshot reading). Unset -> reading is off; typing and pasted text still work. ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=8192
CLAUDE_TIMEOUT_MS=24000

# --- Secrets ---
# Required in production (32+ chars). Dev falls back to a fixed insecure value with a warning.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
# Unset -> admin login disabled. 12+ chars (production refuses to start with a shorter one).
ADMIN_PASSWORD=

# --- App ---
# Required in production (Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}); falls back to https://$RAILWAY_PUBLIC_DOMAIN.
APP_URL=http://localhost:3000

# --- Sales data (DLD open data, REAL_DATA.md) ---
# The committed snapshot folder (sales.csv.gz + buildings.csv.gz + manifest.json). Unset -> <project>/data/open-data.
# The server loads a new snapshot in the background after migrating; it never calls Data.Dubai.
OPEN_DATA_DIR=
# The second tier ("a range from more registered sales" under "Too few sales to compare yet").
# off -> nothing new computes it and no stored range is shown anywhere. Unset -> on.
SIMILAR_TIER=
# The first answer for a matched building: registered sales adjusted to the listing (date, size).
# off -> nothing new computes it and no stored result of it is shown; the site compares with the
# same-building median and the second tier, as before. Unset -> on.
ACS_TIER=
# The last resort: when a building has no usable registered sales, or is not in the data, compare
# with registered sales in other buildings nearby. off -> nothing new computes it and no stored
# result of it is shown; the page reads "Too few sales to compare yet" / "Not covered yet". Unset -> on.
NEARBY_TIER=

# --- Mortgage adviser partner ---
# No default. The adviser opt-in shows only when name, regulator and licence are all set.
PARTNER_NAME=
PARTNER_REGULATOR=
PARTNER_LICENCE=
PARTNER_PROMISE=

# --- Comparison rules ---
MIN_SALES=5
WINDOW_DAYS=365
BAND_PCT=5

# --- Mortgage defaults ---
MORTGAGE_RATE_PCT=4.25
MORTGAGE_YEARS=25
MORTGAGE_DOWN_PCT=20

# --- Limits ---
MAX_IMAGE_BYTES=8388608
EXTRACT_ANON_BURST_LIMIT=6
EXTRACT_ANON_DAILY_LIMIT=20
EXTRACT_IP_DAILY_LIMIT=60
EXTRACT_DAILY_GLOBAL_CAP=1000
CHECKS_ANON_DAILY_LIMIT=100
CHECKS_IP_DAILY_LIMIT=500
LEADS_ANON_DAILY_LIMIT=3
LEADS_PHONE_DAILY_LIMIT=3
LEADS_IP_DAILY_LIMIT=10
LEADS_DAILY_GLOBAL_CAP=500

# --- Platform ---
CSP_MODE=nonce
LOG_LEVEL=info
