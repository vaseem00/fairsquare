# Copy this file to .env and fill in the first two lines.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# From console.anthropic.com (or leave empty if you use `ant auth login`)
ANTHROPIC_API_KEY=

# Your own Telegram user id (ask @userinfobot) - unlocks /stats
ADMIN_USER_ID=

# Keep true until you have licensed sales data
DEMO_MODE=true

# The one mortgage broker who receives opted-in leads.
# PARTNER_CHAT_ID is the Telegram chat that receives them (the broker must /start the bot first).
PARTNER_NAME=Demo Mortgage Partner
PARTNER_CHAT_ID=

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# MIN_SALES=3
# WINDOW_DAYS=365
# BAND_PCT=5
# DAILY_CHECK_LIMIT=20
# MORTGAGE_RATE_PCT=4.25
# MORTGAGE_YEARS=25
# ALERT_HOUR_UTC=2
